{
  "meta": {
    "name": "agent-common",
    "description": "Local grants shared by every sandboxed agent profile"
  },
  "filesystem": {
    "allow": [
      "$HOME/wrksp",
      "$HOME/.agent-browser",
      "$HOME/.agent-device",
      "$HOME/.cargo/registry",
      "$HOME/.cargo/git",
      "$HOME/.npm",
      "$HOME/go/pkg/mod",
      "$HOME/.bun/install",
      "$HOME/.pub-cache/hosted",
      "$HOME/.pub-cache/hosted-hashes",
      "$HOME/.pub-cache/git",
      "$HOME/.pub-cache/_temp",
      "$HOME/.gradle/caches",
      "$HOME/.gradle/daemon",
      "$HOME/.gradle/native",
      "$HOME/.gradle/jdks",
      "$HOME/.m2/repository",
      "$HOME/.local/state/splashdown",
      "$HOME/.local/state/watchman"
    ],
    "read": [
      "/AppleInternal",
      "$HOME/Library/Developer/Xcode",
      "$HOME/Library/Developer/CoreSimulator",
      "$HOME/.local/share/uv/python",
      "$HOME/.local/share/mise/installs",
      "$HOME/.agents/skills",
      "$HOME/ac",
      "$HOME/.yarn",
      "$HOME/.config/yarn",
      "$HOME/.docker/cli-plugins",
      "$HOME/.docker/contexts",
      "$HOME/.claude/projects",
      "$HOME/.local/share/ringleader/archive",
      "$HOME/.codex/sessions",
      "$HOME/.pi/agent/sessions"
    ],
    "read_file": [
      "$HOME/.gitconfig-local",
      "$HOME/.config/gh/config.yml",
      "$HOME/.config/gh/hosts.yml",
      "$HOME/.local/state/gh/device-id",
      "$HOME/.yarnrc",
      "$HOME/.npmrc",
      {
        "path": "$HOME/Library/Keychains/login.keychain-db",
        "when": "macos"
      },
      "$HOME/.docker/config.json",
      "$HOME/.local/share/opencode/opencode.db",
      "$HOME/.local/share/opencode/opencode.db-wal",
      "$HOME/.local/share/opencode/opencode.db-shm"
    ],
    "bypass_protection": [
      "$HOME/.npmrc",
      {
        "path": "$HOME/Library/Keychains/login.keychain-db",
        "when": "macos"
      },
      "$HOME/.docker/config.json",
      "$HOME/.docker/cli-plugins",
      "$HOME/.docker/contexts"
    ],
    "unix_socket": [
      "$HOME/.colima/default/docker.sock"
    ],
    "unix_socket_dir_bind": [
      "$HOME/.agent-browser"
    ],
    "unix_socket_subtree": [
      "$HOME/.local/state/watchman"
    ],
    "suppress_save_prompt": [
      "$HOME",
      "/home",
      "/System",
      "/Users"
    ]
  },
  "network": {
    "open_port": [
      0
    ]
  },
  "unsafe_macos_seatbelt_rules": [
    "(allow mach-register (global-name-prefix \"org.chromium.crashpad.\"))",
    "(allow mach-register (global-name-prefix \"com.google.chrome.for.testing.\"))",
    "(allow iokit-open)"
  ]
}
