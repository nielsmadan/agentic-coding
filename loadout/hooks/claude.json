{
  "PostToolUseFailure": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "~/.claude/hooks/enforce-fix-failures.sh",
          "timeout": 5
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "~/.claude/hooks/redirect-gh-api.sh",
          "timeout": 5
        }
      ]
    },
    {
      "matcher": "WebFetch",
      "hooks": [
        {
          "type": "command",
          "command": "~/.claude/hooks/nudge-jina.sh",
          "timeout": 5
        }
      ]
    }
  ],
  "PermissionRequest": [
    {
      "matcher": "mcp__*",
      "hooks": [
        {
          "type": "command",
          "command": "~/.claude/hooks/auto-approve-mcp.sh",
          "timeout": 5
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "~/.local/bin/agent-sandbox-status",
          "timeout": 5
        }
      ]
    }
  ],
  "Notification": [
    {
      "matcher": "permission_prompt|idle_prompt|elicitation_dialog|elicitation_url_dialog",
      "hooks": [
        {
          "type": "command",
          "command": "~/.claude/hooks/notify-phone.sh",
          "timeout": 10
        }
      ]
    }
  ]
}
