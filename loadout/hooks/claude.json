{
  "PostToolUseFailure": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "~/.claude/hooks/enforce-fix-failures.sh",
          "timeout": 5
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "~/.claude/hooks/redirect-gh-api.sh",
          "timeout": 5
        }
      ]
    },
    {
      "matcher": "WebFetch",
      "hooks": [
        {
          "type": "command",
          "command": "~/.claude/hooks/nudge-jina.sh",
          "timeout": 5
        }
      ]
    }
  ],
  "PermissionRequest": [
    {
      "matcher": "mcp__*",
      "hooks": [
        {
          "type": "command",
          "command": "~/.claude/hooks/auto-approve-mcp.sh",
          "timeout": 5
        }
      ]
    }
  ]
}
