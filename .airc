# ---------------------------------------------------------------------------
#  AI Tools Configuration (Claude, etc.)
#
#  This file is the entry point — it sources every *.zsh under .airc.d/.
#  Add new topic files to .airc.d/<topic>.zsh; this loader picks them up.
#  Standalone CLI tools live in ../bin/ (on PATH via .airc.d/00-path.zsh).
# ---------------------------------------------------------------------------

# ${0:A:h} resolves through any symlink (~/.airc -> repo/.airc) to the repo dir.
_airc_dir="${0:A:h}/.airc.d"
for _airc_f in "$_airc_dir"/*.zsh(N); do
  source "$_airc_f"
done
unset _airc_dir _airc_f
