# ---------------------------------------------------------------------------
#  AI Tools Configuration (Claude, etc.)
# ---------------------------------------------------------------------------

# Claude Code
alias claude="~/.local/bin/claude"
alias clco="claude --continue"

_ccone() { claude -p "$*"; }
alias ccone="noglob _ccone"

_ccli() {
  local input="$*"
  if [[ -z "$input" ]]; then
    local req=""
    vared -p "ccli> " req || return 0
    input="$req"
  fi
  local result
  result=$(claude --model haiku --tools "" --disable-slash-commands --no-session-persistence --system-prompt "You are a shell command generator. Return ONLY a single shell command. No explanation, no markdown, no code blocks." -p "Request: $input")
  result=$(echo "$result" | sed '/^```/d' | sed '/^$/d')
  print -z "$result"
}
alias ccli="noglob _ccli"

_gemcli() {
  local input="$*"
  if [[ -z "$input" ]]; then
    local req=""
    vared -p "gemcli> " req || return 0
    input="$req"
  fi
  local result
  result=$(gemini -m gemini-2.5-flash -e none "Return ONLY a single shell command that can be executed directly. No explanation, no markdown, no code blocks - just the raw command. Request: $input")
  print -z "$result"
}
alias gemcli="noglob _gemcli"

_cxcli() {
  local input="$*"
  if [[ -z "$input" ]]; then
    local req=""
    vared -p "cxcli> " req || return 0
    input="$req"
  fi
  local result
  result=$(codex exec -m gpt-5-codex-mini -s read-only --skip-git-repo-check "Return ONLY a single shell command that can be executed directly. No explanation, no markdown, no code blocks - just the raw command. Request: $input" 2>/dev/null)
  print -z "$result"
}
alias cxcli="noglob _cxcli"

_occli() {
  local input="$*"
  if [[ -z "$input" ]]; then
    local req=""
    vared -p "occli> " req || return 0
    input="$req"
  fi
  local result
  result=$(opencode run -m openrouter/z-ai/glm-5 "Return ONLY a single shell command that can be executed directly. No explanation, no markdown, no code blocks - just the raw command. Request: $input" | tail -1)
  print -z "$result"
}
alias occli="noglob _occli"

_todo() {
  if ! git rev-parse --show-toplevel >/dev/null 2>&1 || [[ "$(pwd)" != "$(git rev-parse --show-toplevel)" ]]; then
    echo "Error: must be in a git repo root directory" >&2
    return 1
  fi
  local interactive=false skill_flags=""
  if [[ "$1" == -* && "$1" != --* ]]; then
    local flags="$1"; shift
    [[ "$flags" == *i* ]] && { interactive=true; skill_flags+="-i "; }
    [[ "$flags" == *c* ]] && skill_flags+="-c "
  fi
  if $interactive; then
    claude "/todo ${skill_flags}$*"
  else
    local prompt="/todo ${skill_flags}$*"
    echo "$prompt" | claude -p --disallowedTools AskUserQuestion > /tmp/todo-last.log 2>&1 &
    disown 2>/dev/null
    echo "Todo queued (pid $!)"
  fi
}
alias todo="noglob _todo"

# OpenCode
alias oc="opencode"
alias ocg="opencode -m openrouter/z-ai/glm-5"
alias ock="opencode -m openrouter/moonshotai/kimi-k2.5"
alias occo="opencode --continue"

# Disable Claude Code feedback prompts
export CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY=1

# Enable auto-memory
CLAUDE_CODE_DISABLE_AUTO_MEMORY=0
