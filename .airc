# ---------------------------------------------------------------------------
#  AI Tools Configuration (Claude, etc.)
# ---------------------------------------------------------------------------

# Claude Code
alias clco="claude --continue"
_clcof() {
  local base="main"
  local recent_name
  recent_name=$(jq -rs --arg cwd "$PWD" '
    map(select(.cwd == $cwd))
    | sort_by(.updatedAt) | reverse
    | .[0].name // ""
  ' ~/.claude/sessions/*.json 2>/dev/null)
  if [[ -n "$recent_name" ]]; then
    base="${recent_name%-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]}"
  fi
  claude --continue --fork-session --name "${base}-$(openssl rand -hex 3)" "$@"
}
alias clcof="noglob _clcof"

_ccone() { claude -p "$*"; }
alias ccone="noglob _ccone"

_ccli() {
  local input="$*"
  if [[ -z "$input" ]]; then
    local req=""
    vared -p "ccli> " req || return 0
    input="$req"
  fi
  local result
  result=$(claude --model haiku --tools "" --disable-slash-commands --no-session-persistence --system-prompt "You are a shell command generator. Return ONLY a single shell command. No explanation, no markdown, no code blocks." -p "Request: $input")
  result=$(echo "$result" | sed '/^```/d' | sed '/^$/d')
  print -z "$result"
}
alias ccli="noglob _ccli"

_gemcli() {
  local input="$*"
  if [[ -z "$input" ]]; then
    local req=""
    vared -p "gemcli> " req || return 0
    input="$req"
  fi
  local result
  result=$(gemini -m gemini-2.5-flash -e none --skip-trust "Return ONLY a single shell command that can be executed directly. No explanation, no markdown, no code blocks - just the raw command. Request: $input")
  print -z "$result"
}
alias gemcli="noglob _gemcli"

_cxcli() {
  local input="$*"
  if [[ -z "$input" ]]; then
    local req=""
    vared -p "cxcli> " req || return 0
    input="$req"
  fi
  local outfile
  outfile=$(mktemp -t cxcli.XXXXXX)
  codex exec -m gpt-5.4-mini -s read-only --skip-git-repo-check --output-last-message "$outfile" "Return ONLY a single shell command that can be executed directly. No explanation, no markdown, no code blocks - just the raw command. Request: $input" >/dev/null 2>&1
  local result
  result=$(sed '/^```/d;/^$/d' "$outfile")
  rm -f "$outfile"
  print -z "$result"
}
alias cxcli="noglob _cxcli"

_occli() {
  local input="$*"
  if [[ -z "$input" ]]; then
    local req=""
    vared -p "occli> " req || return 0
    input="$req"
  fi
  local result
  result=$(opencode run -m openrouter/z-ai/glm-5 "Return ONLY a single shell command that can be executed directly. No explanation, no markdown, no code blocks - just the raw command. Request: $input" | tail -1)
  print -z "$result"
}
alias occli="noglob _occli"

_todo() {
  if ! git rev-parse --show-toplevel >/dev/null 2>&1 || [[ "$(pwd)" != "$(git rev-parse --show-toplevel)" ]]; then
    echo "Error: must be in a git repo root directory" >&2
    return 1
  fi
  local interactive=false skill_flags=""
  if [[ "$1" == -* && "$1" != --* ]]; then
    local flags="$1"; shift
    [[ "$flags" == *i* ]] && { interactive=true; skill_flags+="-i "; }
    [[ "$flags" == *c* ]] && skill_flags+="-c "
  fi
  if $interactive; then
    claude "/todo ${skill_flags}$*"
  else
    local prompt="/todo ${skill_flags}$*"
    echo "$prompt" | claude -p --disallowedTools AskUserQuestion > /tmp/todo-last.log 2>&1 &
    disown 2>/dev/null
    echo "Todo queued (pid $!)"
  fi
}
alias todo="noglob _todo"

# Project template tooling: mechanical install + interactive bidirectional sync
# (repo path resolves via the ~/.airc symlink)
_aiconf() {
  local repo="${${:-$HOME/.airc}:A:h}"
  case "$1" in
    sync)
      shift
      claude "/sync-project-config $*"
      ;;
    help|--help|-h)
      cat <<EOF
aiconf <type> [dir]   install template into dir (default cwd); appends CLAUDE.md
                      snippet on first install for that type (state-tracked)
aiconf sync           run from a project dir: compare project against its template;
                      per-file direction (push vs pull) decided by diff + git history
aiconf sync <dir>     run from ~/ac: same comparison for <dir>
aiconf help           show this message
EOF
      ;;
    *)
      python3 "$repo/templates/deploy.py" "$@"
      ;;
  esac
}
alias aiconf='noglob _aiconf'

# OpenCode
alias oc="opencode"
alias ocg="opencode -m openrouter/z-ai/glm-5"
alias ock="opencode -m openrouter/moonshotai/kimi-k2.5"
alias occo="opencode --continue"

# Disable Claude Code feedback prompts
export CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY=1

# Enable auto-memory
CLAUDE_CODE_DISABLE_AUTO_MEMORY=0
