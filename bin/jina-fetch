#!/usr/bin/env python3
"""Fetch URLs through Jina Reader and extract just what you asked for."""

from __future__ import annotations

import argparse
import concurrent.futures
import dataclasses
import hashlib
import http.client
import os
import re
import secrets
import shutil
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Callable, NoReturn, TypeVar

sys.path.insert(0, str(Path(__file__).resolve().parent))
from extraction import (
    DEFAULT_MODEL,
    Extraction,
    NO_RELEVANT,
    OPENER,
    Page,
    ToolError,
    extract,
    fence_document,
    fence_sources,
    off_topic_terms,
    require_key,
    warn,
)

DEFAULT_PROMPT = "Summarize this page."

THIN_CONTENT = 500
MAX_PARALLEL = 5
# Statuses the browser engine cannot change: auth, billing, rate limit, absent,
# unprocessable. 403 is deliberately absent — it can mean the origin blocked
# Jina, which is exactly what the browser engine is for.
NO_RETRY_STATUS = frozenset({400, 401, 402, 404, 410, 422, 429, 451})
# Jina header warnings that mean "no page was retrieved", as opposed to the
# advisory ones it emits about pages it did retrieve.
FAILED_FETCH = re.compile(
    r"Target URL returned error|requiring CAPTCHA|authorized to access", re.I
)

T = TypeVar("T")
R = TypeVar("R")


@dataclasses.dataclass(frozen=True)
class Failure:
    url: str
    error: str


def die(msg: str) -> NoReturn:
    warn(msg)
    sys.exit(1)


def cache_dir() -> str:
    path = os.path.join(tempfile.gettempdir(), "jina-fetch")
    os.makedirs(path, mode=0o700, exist_ok=True)
    return path


def cache_path(url: str) -> str:
    digest = hashlib.sha256(url.encode()).hexdigest()[:16]
    return os.path.join(cache_dir(), f"{digest}.md")


def page_title(doc: str) -> str:
    for line in doc.splitlines()[:5]:
        if line.startswith("Title: "):
            return line[len("Title: ") :].strip()
    return ""


def jina_warning(doc: str) -> str:
    """Jina reports a failed origin fetch as a Warning line in its header block.

    Far more reliable than a length threshold: a 403 interstitial or CAPTCHA
    page can be arbitrarily long. Only fetch *failures* count — Jina also emits
    advisory warnings ("shadow DOM", "cached snapshot", "not yet fully loaded")
    on pages that did load, and those are real content worth caching.
    """
    for line in doc.splitlines():
        if line.startswith("Markdown Content:"):
            break
        if line.startswith("Warning: ") and FAILED_FETCH.search(line):
            return line[len("Warning: ") :].strip()
    return ""


def looks_blocked(doc: str) -> str:
    """Why this response looks like a failed fetch rather than a page, or ''."""
    problem = jina_warning(doc)
    if problem:
        return problem
    stripped = len(doc.strip())
    if stripped < THIN_CONTENT:
        return f"only {stripped} chars — the host likely blocked Jina too"
    return ""


def is_url(arg: str) -> bool:
    if any(c.isspace() for c in arg):
        return False
    parsed = urllib.parse.urlparse(arg)
    return parsed.scheme in ("http", "https") and bool(parsed.netloc)


def looks_like_scheme(arg: str) -> bool:
    return bool(re.match(r"^[A-Za-z][A-Za-z0-9+.-]*://", arg)) and not any(
        c.isspace() for c in arg
    )


def split_args(args: list[str]) -> tuple[list[str], str, list[str]]:
    """Leading run of URLs, then everything else joined into the prompt."""
    urls: list[str] = []
    for i, a in enumerate(args):
        if is_url(a):
            urls.append(a)
            continue
        if looks_like_scheme(a):
            raise ToolError(f"unsupported URL scheme: {a} (only http/https)")
        rest = args[i:]
        stray = [tok for arg in rest for tok in arg.split() if is_url(tok)]
        notes = []
        if stray:
            notes.append(
                "these URLs came after the prompt, so they were folded into the "
                f"question rather than fetched: {', '.join(stray)}"
            )
        return urls, " ".join(rest), notes
    return urls, DEFAULT_PROMPT, []


def in_parallel(fn: Callable[[T], R], items: list[T]) -> list[R]:
    if len(items) == 1:
        return [fn(items[0])]
    pool = concurrent.futures.ThreadPoolExecutor(max_workers=MAX_PARALLEL)
    try:
        return list(pool.map(fn, items))
    finally:
        pool.shutdown(wait=False, cancel_futures=True)


def fetch(url: str, timeout: int, proxy: str | None = None) -> str:
    headers = {
        "Authorization": "Bearer " + require_key("JINA_API_KEY"),
        "X-Return-Format": "markdown",
        # Jina 403s the default Python-urllib User-Agent.
        "User-Agent": "jina-fetch/1.0",
    }
    if proxy:
        headers["X-Proxy"] = proxy
    attempts: list[str] = []
    thin: str | None = None
    # A host that blocks Jina answers 200 with a stub body rather than an error
    # status, so thin content — not an exception — is what the browser engine
    # is here to retry.
    for engine in (None, "browser"):
        label = engine or "default"
        attempt = dict(headers)
        if engine:
            attempt["X-Engine"] = engine
        req = urllib.request.Request("https://r.jina.ai/" + url, headers=attempt)
        try:
            with OPENER.open(req, timeout=timeout) as resp:
                doc = resp.read().decode("utf-8", "replace")
        except urllib.error.HTTPError as e:
            attempts.append(f"{label} engine: HTTP {e.code}")
            if e.code in NO_RETRY_STATUS:
                break
            continue
        except TimeoutError:
            # The browser engine is slower, so a retry just doubles the wait.
            attempts.append(f"{label} engine: timed out after {timeout}s")
            break
        except (urllib.error.URLError, OSError) as e:
            attempts.append(f"{label} engine: {getattr(e, 'reason', e)}")
            continue
        except (http.client.HTTPException, ValueError) as e:
            attempts.append(f"{label} engine: {e}")
            break
        blocked = looks_blocked(doc)
        if not blocked:
            return doc
        thin = doc
        attempts.append(f"{label} engine: {blocked}")
    if thin is not None:
        return thin
    raise ToolError(f"Jina could not fetch {url} ({'; '.join(attempts)})")


def load(url: str, timeout: int, use_cache: bool, proxy: str | None = None) -> Page:
    path = cache_path(url)
    if use_cache and os.path.exists(path):
        with open(path, encoding="utf-8") as f:
            return Page(url, path, f.read())
    doc = fetch(url, timeout, proxy)
    # A blocked host returns 200 with an interstitial. Caching that would serve
    # the block page instantly forever, so only real pages are written — via a
    # temp file, so an interrupted run cannot leave a partial page behind.
    if not looks_blocked(doc):
        tmp = f"{path}.{os.getpid()}.tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(doc)
        os.replace(tmp, path)
    return Page(url, path, doc)


def report_page(page: Page, prompt: str, proxy: str | None = None) -> None:
    title = page_title(page.doc)
    # The exact path — "newest file in the cache dir" is wrong when fetches overlap.
    where = page.path if os.path.exists(page.path) else "(not cached)"
    lines = [f"{page.url}\n  cached: {where} ({len(page.doc)} chars)"]
    if title:
        lines.append(f"  title:  {title}")
    warn("\n".join(lines))
    blocked = looks_blocked(page.doc)
    if blocked:
        warn(f"warning: Jina could not really read {page.url} — {blocked} (not cached)")
        if not proxy:
            warn(
                "  hint: retry with --proxy to route through Jina's "
                "residential pool, which reaches Reddit and many bot walls"
            )
    if prompt != DEFAULT_PROMPT:
        missing = off_topic_terms(prompt, page.doc)
        if missing:
            warn(
                f"warning: none of the question's key terms appear on this "
                f"page ({', '.join(missing[:6])}) — it may be off-topic"
            )


def warn_if_off_topic(label: str, answer: str) -> None:
    if answer.startswith(NO_RELEVANT):
        warn(f"warning: the page does not address the question — {label}")


def clean_cache(targets: list[str] | None, everything: bool) -> None:
    if everything:
        shutil.rmtree(cache_dir(), ignore_errors=True)
        warn("cache cleared")
    for url in targets or []:
        path = cache_path(url)
        if os.path.exists(path):
            os.remove(path)
        warn(f"dropped cache for {url}")


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="jina-fetch",
        description="Fetch URLs via Jina Reader, return only the extract.",
        epilog=(
            "Pass several URLs to read them in parallel: "
            'jina-fetch URL URL URL "what to extract". Each page is extracted '
            "separately unless --combined. URLs must come before the prompt. "
            "Pages are cached under TMPDIR and reused; --clean/--clean-all "
            "drop them."
        ),
    )
    p.add_argument(
        "args",
        nargs="*",
        metavar="URL... [PROMPT]",
        help=f"one or more URLs, then what to extract (default: {DEFAULT_PROMPT!r})",
    )
    p.add_argument(
        "--combined",
        action="store_true",
        help="one extraction across all pages (for comparisons) "
        "instead of one per page",
    )
    p.add_argument(
        "--raw", action="store_true", help="print the full markdown, skip the model"
    )
    p.add_argument(
        "--model",
        default=None,
        help=f"OpenRouter model (default: $JINA_FETCH_MODEL, else {DEFAULT_MODEL})",
    )
    p.add_argument("--out", metavar="PATH", help="also write the full markdown here")
    p.add_argument("--no-cache", action="store_true", help="re-fetch even if cached")
    p.add_argument(
        "--proxy",
        action="store_true",
        help="route through Jina's rotating residential proxy pool, "
        "which reaches Reddit and many bot-walled hosts",
    )
    p.add_argument(
        "--proxy-country",
        metavar="CC",
        default=None,
        help="pin the proxy to a country, e.g. de. Needs the paid "
        "Proxy allocation tier and 402s without it. Implies --proxy",
    )
    p.add_argument(
        "--clean",
        metavar="URL",
        action="append",
        help="drop the cache for URL (repeatable)",
    )
    p.add_argument("--clean-all", action="store_true", help="drop the entire cache")
    p.add_argument(
        "--timeout", type=int, default=120, help="per-request timeout (default: 120)"
    )
    return p


def main() -> int:
    p = build_parser()
    opts = p.parse_args()

    if opts.clean or opts.clean_all:
        clean_cache(opts.clean, opts.clean_all)
        if not opts.args:
            return 0

    try:
        urls, prompt, notes = split_args(opts.args)
    except ToolError as e:
        p.error(str(e))
    for note in notes:
        warn(f"warning: {note}")
    if not urls:
        p.error("at least one URL is required (must start with http:// or https://)")

    model = opts.model or os.environ.get("JINA_FETCH_MODEL") or DEFAULT_MODEL
    if opts.raw:
        ignored = [
            name
            for name, used in (
                ("--combined", opts.combined),
                ("--model", opts.model is not None),
                ("the prompt", prompt != DEFAULT_PROMPT),
            )
            if used
        ]
        if ignored:
            warn(
                f"warning: --raw skips the model, so {', '.join(ignored)} had no effect"
            )

    proxy = opts.proxy_country or ("auto" if opts.proxy else None)
    results = in_parallel(
        lambda u: _load_or_fail(u, opts.timeout, not opts.no_cache, proxy),
        urls,
    )
    pages = [r for r in results if isinstance(r, Page)]
    failures = [r for r in results if isinstance(r, Failure)]
    for failure in failures:
        warn(f"failed: {failure.url} — {failure.error}")
    if not pages:
        return 1

    for page in pages:
        report_page(page, prompt, proxy)

    if opts.out:
        with open(opts.out, "w", encoding="utf-8") as f:
            f.write("\n\n".join(f"# {p_.url}\n\n{p_.doc}" for p_ in pages))

    if opts.raw:
        for page in pages:
            if len(pages) > 1:
                print(f"\n===== {page.url} =====\n")
            print(page.doc)
        return 1 if failures else 0

    nonce = secrets.token_hex(8)
    ex = Extraction(prompt=prompt, model=model, timeout=opts.timeout)

    if opts.combined or len(pages) == 1:
        label = ", ".join(p_.url for p_ in pages)
        try:
            answer = extract(fence_sources(pages, nonce), ex, nonce)
        except ToolError as e:
            warn(f"failed: {label} — {e}")
            return 1
        warn_if_off_topic(label, answer)
        print(answer)
        return 1 if failures else 0

    answers = in_parallel(lambda page: _extract_or_fail(page, ex, nonce), pages)
    for page, answer in zip(pages, answers):
        if isinstance(answer, Failure):
            warn(f"failed: {page.url} — {answer.error}")
            failures.append(answer)
            continue
        print(f"===== {page.url} =====")
        warn_if_off_topic(page.url, answer)
        print(answer)
        print()
    return 1 if failures else 0


def _load_or_fail(
    url: str, timeout: int, use_cache: bool, proxy: str | None = None
) -> Page | Failure:
    try:
        return load(url, timeout, use_cache, proxy)
    except ToolError as e:
        return Failure(url, str(e))


def _extract_or_fail(page: Page, ex: Extraction, nonce: str) -> str | Failure:
    try:
        return extract(fence_document(page.doc, nonce), ex, nonce)
    except ToolError as e:
        return Failure(page.url, str(e))


if __name__ == "__main__":
    sys.exit(main())
