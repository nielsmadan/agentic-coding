#!/usr/bin/env python3

import argparse
import fcntl
import json
import os
import subprocess
import sys
import tempfile
from contextlib import contextmanager
from pathlib import Path
from uuid import UUID, uuid4

RECIPES = {"claude", "claude-raw", "clor", "codex", "codex-raw"}


def register(root, pane, recipe, pid, cwd, forced):
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = root.lstat()
    if root.is_symlink() or info.st_uid != os.getuid():
        raise ValueError("agent resume state directory must be private")
    root.chmod(0o700)
    directory = root / "launches"
    directory.mkdir(mode=0o700, exist_ok=True)
    snapshot = subprocess.check_output(
        ["/bin/ps", "-axo", "pid=,ppid=,lstart="],
        text=True,
        env={"LC_ALL": "C"},
        timeout=3,
    )
    processes = {
        int(p): (int(parent), stamp.strip())
        for p, parent, stamp in (line.split(None, 2) for line in snapshot.splitlines())
    }
    started = processes.get(pid, (None, ""))[1]
    descendants = {pid}
    while True:
        expanded = descendants | {
            p for p, (parent, _) in processes.items() if parent in descendants
        }
        if expanded == descendants:
            break
        descendants = expanded
    if not started:
        raise ValueError("launching shell is no longer running")
    token = str(uuid4())
    data = {
        "version": 1,
        "recipe": recipe,
        "pid": pid,
        "startedAt": started,
        "cwd": cwd,
        "forceSandbox": forced,
        "token": token,
        "priorProcesses": [
            f"{p}:{processes[p][1]}" for p in sorted(descendants) if p in processes
        ],
    }
    with pane_lock(directory, pane):
        write_record(directory / (pane + ".json"), data)
    return token


def write_record(path, data):
    fd, name = tempfile.mkstemp(dir=path.parent)
    try:
        with os.fdopen(fd, "w") as handle:
            json.dump(data, handle)
        os.replace(name, path)
    finally:
        Path(name).unlink(missing_ok=True)


@contextmanager
def pane_lock(directory, pane):
    fd = os.open(
        directory / (pane + ".lock"), os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600
    )
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def finish(root, pane, token, status):
    token = str(UUID(token))
    directory = root / "launches"
    with pane_lock(directory, pane):
        outcomes = root / "outcomes"
        outcomes.mkdir(mode=0o700, exist_ok=True)
        outcome = {
            "version": 1,
            "token": token,
            "pane": pane,
            "ended": status in (0, 130),
        }
        write_record(outcomes / (token + ".json"), outcome)
        path = directory / (pane + ".json")
        if path.exists():
            current = json.loads(path.read_text())
            if current.get("token") == token:
                write_record(
                    path, {**current, "finished": True, "ended": outcome["ended"]}
                )


def main():
    parser = argparse.ArgumentParser(
        description="Record an outer iTerm2 agent wrapper launch"
    )
    parser.add_argument("action", choices=("start", "end"))
    parser.add_argument("value")
    parser.add_argument("--pid", type=int)
    parser.add_argument("--force-sandbox", action="store_true")
    parser.add_argument("--exit-status", type=int)
    args = parser.parse_args()
    root = Path.home() / ".local/state/iterm-agent-resume"
    pane = str(UUID(os.environ["ITERM_SESSION_ID"].rsplit(":", 1)[-1])).upper()
    if args.action == "start":
        if args.value not in RECIPES or not args.pid:
            parser.error("start requires an allowed recipe and --pid")
        print(
            register(root, pane, args.value, args.pid, os.getcwd(), args.force_sandbox)
        )
    else:
        finish(root, pane, args.value, args.exit_status)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        print(f"Agent launch recording unavailable: {exc}", file=sys.stderr)
        sys.exit(1)
