#!/usr/bin/env python3
"""Ask a cheap model a question about text on stdin or in files; print only the answer."""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import secrets
import sys
from pathlib import Path

# The prompt, model, fallback and fencing are jina-fetch's, imported rather than
# copied so the benchmarked extraction setup has one definition.
_JF_PATH = Path(__file__).resolve().with_name("jina-fetch")
_LOADER = importlib.machinery.SourceFileLoader("jina_fetch", str(_JF_PATH))
_SPEC = importlib.util.spec_from_loader(_LOADER.name, _LOADER)
jf = importlib.util.module_from_spec(_SPEC)
# dataclasses resolves string annotations through sys.modules during exec.
sys.modules["jina_fetch"] = jf
_LOADER.exec_module(jf)

# Both extraction models take 1M tokens; dense text runs near 3 chars a token.
MAX_CHARS = 2_500_000


def read_sources(paths: list[str], stdin) -> list[jf.Page]:
    if not paths:
        if stdin.isatty():
            raise jf.ToolError("no input: pipe text in or name files after the question")
        text = stdin.buffer.read().decode("utf-8", errors="replace")
        return [jf.Page("stdin", "stdin", text)]
    try:
        return [jf.Page(p, p, Path(p).read_text(encoding="utf-8", errors="replace"))
                for p in paths]
    except OSError as e:
        raise jf.ToolError(str(e))


def check_size(sources: list[jf.Page]) -> None:
    total = sum(len(s.doc) for s in sources)
    if not any(s.doc.strip() for s in sources):
        raise jf.ToolError("input is empty")
    if total > MAX_CHARS:
        raise jf.ToolError(
            f"input is {total} chars, over the {MAX_CHARS} limit; narrow it first"
        )


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="distill",
        description="Answer a question from text on stdin or in files, using a "
                    "cheap OpenRouter model, so the text never enters your context.",
        epilog='Example: some-command | tee "$TMPDIR/out.txt" | distill "what failed?"',
    )
    p.add_argument("question", help="what to extract from the text")
    p.add_argument("files", nargs="*", help="files to read instead of stdin")
    p.add_argument("--model", default=jf.DEFAULT_MODEL,
                   help=f"OpenRouter model (default: {jf.DEFAULT_MODEL})")
    p.add_argument("--timeout", type=int, default=120,
                   help="request timeout in seconds (default: 120)")
    return p


def main() -> int:
    opts = build_parser().parse_args()
    try:
        sources = read_sources(opts.files, sys.stdin)
        check_size(sources)
    except jf.ToolError as e:
        jf.warn(str(e))
        return 1

    label = ", ".join(s.url for s in sources)
    jf.warn(f"{label}: {sum(len(s.doc) for s in sources)} chars")
    missing = jf.off_topic_terms(opts.question, "\n".join(s.doc for s in sources))
    if missing:
        jf.warn(f"warning: none of the question's key terms appear in the input "
                f"({', '.join(missing[:6])})")

    nonce = secrets.token_hex(8)
    ex = jf.Extraction(prompt=opts.question, model=opts.model, timeout=opts.timeout)
    try:
        answer = jf.extract(jf.fence_sources(sources, nonce), ex, nonce)
    except jf.ToolError as e:
        jf.warn(f"failed: {e}")
        return 1
    if answer.startswith(jf.NO_RELEVANT):
        jf.warn("warning: the input does not address the question")
    print(answer)
    return 0


if __name__ == "__main__":
    sys.exit(main())
