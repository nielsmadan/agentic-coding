#!/usr/bin/env python3
"""Relocate Claude Code session storage when a project folder moves on disk.

Renames the slug dir under ~/.claude/projects/. JSONL transcripts are NOT
rewritten: old absolute paths remain in historical tool calls/results; cwd
for new turns picks up the new project path.

If the target slug dir already exists, its sessions are kept and the source's
sessions are merged in. On a filename collision the incoming file is renamed
`<stem>-N`, and a colliding .jsonl has its internal sessionId rewritten to
match so it stays resumable.

The session slug is the absolute project path with every non-alphanumeric
character replaced by `-` (so `/`, `.`, `_`, `@`, spaces, etc. all collapse to
`-` individually, without merging runs). If the result exceeds 200 chars, Claude
Code truncates it to 200 and appends `-<hash>`, where <hash> is base36 of the
absolute value of a 31-multiplier rolling hash over the original path. This
mirrors Claude Code's own slug function exactly.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import sys
import textwrap
from datetime import datetime
from pathlib import Path

SLUG_MAX_LEN = 200  # Claude Code truncates longer slugs and appends a hash.


def _rolling_hash(s: str) -> int:
    # Replicates Claude Code's `h = (h << 5) - h + charCode | 0` (hash*31 + c,
    # truncated to a signed 32-bit int each step).
    h = 0
    for ch in s:
        h = (h << 5) - h + ord(ch)
        h &= 0xFFFFFFFF
        if h >= 0x80000000:
            h -= 0x100000000
    return h


def _base36(n: int) -> str:
    if n == 0:
        return "0"
    digits = "0123456789abcdefghijklmnopqrstuvwxyz"
    out = ""
    while n:
        n, r = divmod(n, 36)
        out = digits[r] + out
    return out


def slugify(path: Path) -> str:
    raw = str(path)
    slug = re.sub(r"[^a-zA-Z0-9]", "-", raw)
    if len(slug) <= SLUG_MAX_LEN:
        return slug
    return slug[:SLUG_MAX_LEN] + "-" + _base36(abs(_rolling_hash(raw)))


def free_name(directory: Path, name: str) -> Path:
    # First free `<stem>-N<suffix>` in `directory` (N starts at 1).
    p = Path(name)
    stem, suffix = p.stem, p.suffix
    i = 1
    while True:
        cand = directory / f"{stem}-{i}{suffix}"
        if not cand.exists():
            return cand
        i += 1


def merge_dir(src_dir: Path, tgt_dir: Path) -> tuple[int, list[tuple[str, str]]]:
    # Move every entry of src_dir into tgt_dir, keeping both sides' sessions.
    # On a name collision, rename to `<stem>-N`; for a colliding .jsonl that
    # also renames the session, rewrite its internal sessionId to match the new
    # filename so the session stays self-consistent (stem == sessionId).
    moved = 0
    renamed: list[tuple[str, str]] = []
    for entry in sorted(src_dir.iterdir()):
        dest = tgt_dir / entry.name
        if dest.exists():
            dest = free_name(tgt_dir, entry.name)
            shutil.move(str(entry), str(dest))
            if dest.suffix == ".jsonl" and dest.is_file():
                text = dest.read_text()
                dest.write_text(text.replace(entry.stem, dest.stem))
            renamed.append((entry.name, dest.name))
        else:
            shutil.move(str(entry), str(dest))
        moved += 1
    src_dir.rmdir()  # everything moved out; remove the now-empty source slug dir
    return moved, renamed


# Durable name entries Claude Code appends to a transcript. A session can be
# renamed repeatedly, so each may appear many times; the last value is current.
NAME_KEYS = ("customTitle", "agentName", "aiTitle")


def session_names(jsonl_path: Path) -> tuple[set[str], str]:
    """Return (all_names, current_name) for a session transcript.

    Scans the name entries Claude Code writes — customTitle (/rename), agentName,
    aiTitle. `all_names` is every name the session has ever carried (rename
    history included); `current` is the latest customTitle, else agentName, else
    aiTitle. Matching on the full history is what lets a since-renamed session
    still resolve by an older name (e.g. its original --name / resume name).
    """
    all_names: set[str] = set()
    latest: dict[str, str] = {}
    try:
        with open(jsonl_path, encoding="utf-8") as f:
            for line in f:
                if 'Title"' not in line and 'Name"' not in line:
                    continue
                try:
                    entry = json.loads(line)
                except json.JSONDecodeError:
                    continue
                for k in NAME_KEYS:
                    v = entry.get(k)
                    if isinstance(v, str) and v:
                        all_names.add(v)
                        latest[k] = v
    except OSError:
        return set(), ""
    current = latest.get("customTitle") or latest.get("agentName") or latest.get("aiTitle") or ""
    return all_names, current


def registry_names() -> dict[str, str]:
    """Map sessionId -> launch/resume name from ~/.claude/sessions/*.json.

    This is the `--name` / `claude --resume "<name>"` identifier. It's runtime
    state (pruned for stopped sessions), so it only augments the durable
    transcript names — it isn't relied on alone.
    """
    out: dict[str, str] = {}
    sessions = Path.home() / ".claude" / "sessions"
    if not sessions.is_dir():
        return out
    for p in sessions.glob("*.json"):
        try:
            d = json.loads(p.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        sid, name = d.get("sessionId"), d.get("name")
        if sid and name:
            out[sid] = name
    return out


def find_session(src_dir: Path, query: str):
    """Locate the single session matching `query`, returning (jsonl, candidates).

    Precedence: an exact sessionId (filename stem) wins; then an exact match
    (case-insensitive) against any name the session carries — customTitle,
    agentName, aiTitle, or its --resume name; only if neither is unique do we
    fall back to sessionId prefix and name substring. Exactly one match returns
    (path, []). Zero or many returns (None, candidates), candidates being
    (sessionId, current_name, mtime) tuples sorted newest-first.
    """
    jsonls = sorted(p for p in src_dir.glob("*.jsonl") if p.is_file())
    for p in jsonls:
        if p.stem == query:
            return p, []
    reg = registry_names()
    q = query.lower()
    info: dict[Path, tuple[set[str], str, float]] = {}
    for p in jsonls:
        names, current = session_names(p)
        if p.stem in reg:
            names = names | {reg[p.stem]}
            current = current or reg[p.stem]
        info[p] = ({n.lower() for n in names}, current, p.stat().st_mtime)

    exact = [p for p in jsonls if q in info[p][0]]
    if len(exact) == 1:
        return exact[0], []
    matches = [p for p in jsonls
               if p.stem.startswith(query) or any(q in n for n in info[p][0])]
    if len(matches) == 1:
        return matches[0], []
    # Report the exact-name set when it's the source of ambiguity, else the
    # broader substring matches.
    pool = exact or matches
    cands = sorted(((p.stem, info[p][1], info[p][2]) for p in pool),
                   key=lambda c: c[2], reverse=True)
    return None, cands


def free_stem(directory: Path, stem: str) -> str:
    # First `<stem>-N` whose `.jsonl` and sidecar dir are both free in directory.
    i = 1
    while True:
        cand = f"{stem}-{i}"
        if not (directory / f"{cand}.jsonl").exists() and not (directory / cand).exists():
            return cand
        i += 1


def move_one_session(src_dir: Path, tgt_dir: Path, jsonl: Path) -> tuple[str, str, bool]:
    # Move one session (its .jsonl and optional `<sessionId>/` sidecar dir) into
    # tgt_dir. On a name collision, rename both to `<stem>-N` and rewrite the
    # .jsonl's internal sessionId to match. Returns (old_stem, new_stem, renamed).
    stem = jsonl.stem
    sidecar = src_dir / stem
    has_sidecar = sidecar.is_dir()
    collision = (tgt_dir / f"{stem}.jsonl").exists() or (has_sidecar and (tgt_dir / stem).exists())
    new_stem = free_stem(tgt_dir, stem) if collision else stem

    dest_jsonl = tgt_dir / f"{new_stem}.jsonl"
    shutil.move(str(jsonl), str(dest_jsonl))
    if collision:
        dest_jsonl.write_text(dest_jsonl.read_text().replace(stem, new_stem))
    if has_sidecar:
        shutil.move(str(sidecar), str(tgt_dir / new_stem))
    return stem, new_stem, collision


def normalize(p: Path) -> Path:
    # abspath: expand to absolute and normalize ., .. — without following symlinks
    # (matches the zsh `:a` modifier used in the previous implementation).
    return Path(os.path.abspath(str(p.expanduser())))


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="ccmove",
        description="Relocate Claude Code session storage when a project folder moves on disk.",
        epilog=textwrap.dedent("""\
            Notes:
              - By default, operates on session storage only. Move the actual
                project folder yourself (mv, git mv, etc.) before or after
                running ccmove, or pass --include-dir to move it too.
              - With -n/--name, only the one matching session (its .jsonl plus
                any `<sessionId>/` sidecar dir) is moved; the rest of the
                source's sessions stay put. Match is by sessionId, a unique
                sessionId prefix, or session name — the --resume name, /rename
                title, or ai-title (current or any past name), exact-match first.
              - If the target session dir exists, its sessions are kept and the
                source's are merged in (colliding files are renamed).
              - JSONL transcripts are NOT rewritten, except a colliding merged
                file's sessionId. Old absolute paths remain in history; cwd for
                new turns picks up the new path.
        """),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument("source_pos", nargs="?", type=Path, metavar="SOURCE",
                    help="source project directory (old path), positional form")
    ap.add_argument("target_pos", nargs="?", type=Path, metavar="TARGET",
                    help="target project directory (new path), positional form")
    ap.add_argument("-s", "--source", type=Path,
                    help="source project directory (old path)")
    ap.add_argument("-t", "--target", type=Path,
                    help="target project directory (new path)")
    ap.add_argument("-d", "--include-dir", action="store_true",
                    help="also move the project folder on disk (source -> target)")
    ap.add_argument("-n", "--name", dest="session", metavar="SESSION",
                    help="move only the one session matching SESSION (sessionId, "
                         "unique sessionId prefix, or session name — the --resume "
                         "name, /rename title, or ai-title, current or historical) "
                         "instead of the whole project's session storage")
    ap.add_argument("--dry-run", action="store_true",
                    help="print planned move, don't run")
    args = ap.parse_args()

    # Accept source/target via flags or positionally; a flag wins if both given.
    source = args.source if args.source is not None else args.source_pos
    target = args.target if args.target is not None else args.target_pos
    missing = [n for n, v in (("source", source), ("target", target)) if v is None]
    if missing:
        ap.error("the following arguments are required: " + ", ".join(missing))

    src = normalize(source)
    tgt = normalize(target)
    src_slug = slugify(src)
    tgt_slug = slugify(tgt)
    base = Path.home() / ".claude" / "projects"
    src_dir = base / src_slug
    tgt_dir = base / tgt_slug

    if src_slug == tgt_slug:
        print(f"ccmove: source and target slugs are identical ({src_slug}); nothing to do",
              file=sys.stderr)
        return 1
    if not src_dir.is_dir():
        print(f"ccmove: source session dir does not exist: {src_dir}", file=sys.stderr)
        return 1

    if args.session is not None:
        if args.include_dir:
            print("ccmove: -n/--name moves a single session and can't be combined with "
                  "-d/--include-dir", file=sys.stderr)
            return 1
        jsonl, candidates = find_session(src_dir, args.session)
        if jsonl is None:
            if candidates:
                print(f"ccmove: {len(candidates)} sessions match {args.session!r}; "
                      "pass a sessionId (or prefix) to pick one:", file=sys.stderr)
                for i, (sid, title, mtime) in enumerate(candidates):
                    when = datetime.fromtimestamp(mtime).strftime("%Y-%m-%d %H:%M")
                    tag = "  <- most recently active" if i == 0 else ""
                    print(f"  {sid}  {when}  {title}{tag}".rstrip(), file=sys.stderr)
            else:
                print(f"ccmove: no session in {src_dir} matched {args.session!r}",
                      file=sys.stderr)
            return 1

        stem = jsonl.stem
        has_sidecar = (src_dir / stem).is_dir()
        label = f"session {stem}" + (" (+ sidecar dir)" if has_sidecar else "")
        if args.dry_run:
            collision = tgt_dir.exists() and (
                (tgt_dir / f"{stem}.jsonl").exists()
                or (has_sidecar and (tgt_dir / stem).exists())
            )
            print("ccmove: dry-run — would run:")
            if collision:
                new_stem = free_stem(tgt_dir, stem)
                print(f"  move {label} into {tgt_dir} as {new_stem} "
                      "(renamed on collision, sessionId rewritten)")
            else:
                where = "existing " if tgt_dir.exists() else "new "
                print(f"  move {label} into {where}{tgt_dir}")
            return 0

        tgt_dir.mkdir(parents=True, exist_ok=True)
        old_stem, new_stem, renamed = move_one_session(src_dir, tgt_dir, jsonl)
        if renamed:
            print(f"ccmove: moved session {old_stem} -> {tgt_dir}/{new_stem} "
                  "(renamed on collision, sessionId rewritten)")
        else:
            print(f"ccmove: moved session {new_stem} to {tgt_dir}")
        if has_sidecar:
            print("  included session sidecar directory (subagents/tool-results)")
        print("  note: JSONL transcript retains old absolute paths in its history;")
        print("        cwd for new turns will reflect the new project path.")
        return 0

    # An existing target session dir is merged into; the on-disk project folder
    # is never merged — refuse if its target already exists.
    if args.include_dir:
        if not src.is_dir():
            print(f"ccmove: source project dir does not exist: {src}", file=sys.stderr)
            return 1
        if tgt.exists():
            print(f"ccmove: target project dir already exists: {tgt} (refusing to overwrite)",
                  file=sys.stderr)
            return 1

    if args.dry_run:
        print("ccmove: dry-run — would run:")
        if args.include_dir:
            print(f"  mv {src} {tgt}")
        if tgt_dir.exists():
            entries = list(src_dir.iterdir())
            collisions = [e.name for e in entries if (tgt_dir / e.name).exists()]
            print(f"  merge {len(entries)} item(s) from {src_dir} into existing {tgt_dir}")
            if collisions:
                print(f"    rename {len(collisions)} colliding item(s) (sessionId rewritten): "
                      + ", ".join(sorted(collisions)))
        else:
            print(f"  mv {src_dir} {tgt_dir}")
        return 0

    if args.include_dir:
        tgt.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(src), str(tgt))
        print(f"ccmove: moved project folder {src} -> {tgt}")

    if tgt_dir.exists():
        moved, renamed = merge_dir(src_dir, tgt_dir)
        print(f"ccmove: merged {moved} item(s) into existing {tgt_dir}")
        for old, new in renamed:
            print(f"  renamed on collision: {old} -> {new} (sessionId rewritten)")
    else:
        shutil.move(str(src_dir), str(tgt_dir))
        n = sum(1 for _ in tgt_dir.glob("*.jsonl"))
        print(f"ccmove: moved {n} session file(s) to {tgt_dir}")
    print("  note: JSONL transcripts retain old absolute paths in their history;")
    print("        cwd for new turns will reflect the new project path.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
