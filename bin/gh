#!/usr/bin/env python3
"""Run `gh` with the read-only token that matches the repository's owner.

Invoked through the `gh` zsh function in .airc.d/gh.zsh — a PATH shim cannot work
here because mise re-prepends its own bin directories on every prompt.

Fine-grained PATs are scoped to a single resource owner, so one token cannot
cover both a personal account and an organisation. This picks `GH_TOKEN_<OWNER>`
(uppercased, non-alphanumerics to `_`) from the owner of `-R owner/repo` when
given, otherwise from the origin remote of the working directory. Falls back to
whatever `GH_TOKEN` already holds.

Set the per-owner variables in the sops store, never here.
"""

from __future__ import annotations

import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

SELF = Path(__file__).resolve()
REMOTE = re.compile(r"github\.com[:/]([^/]+)/")


def real_gh() -> str:
    for entry in os.environ.get("PATH", "").split(os.pathsep):
        candidate = Path(entry) / "gh"
        if candidate.is_file() and os.access(candidate, os.X_OK):
            if candidate.resolve() != SELF:
                return str(candidate)
    sys.exit("gh: the real gh is not on PATH")


SLUG = re.compile(r"^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$")
API_PATH = re.compile(r"^/?repos/([A-Za-z0-9._-]+)/")


def owner_of(value: str) -> str | None:
    """Owner from a remote URL, an `owner/repo` slug, or a `repos/owner/…` API path."""
    match = REMOTE.search(value)
    if match:
        return match.group(1)
    match = API_PATH.match(value)
    if match:
        return match.group(1)
    if SLUG.match(value):
        return value.split("/", 1)[0]
    return None


def owner_from_args(argv: list[str]) -> str | None:
    for index, arg in enumerate(argv):
        if arg in ("-R", "--repo") and index + 1 < len(argv):
            owner = owner_of(argv[index + 1])
            if owner:
                return owner
        elif arg.startswith("--repo="):
            owner = owner_of(arg.split("=", 1)[1])
            if owner:
                return owner
    # positional `owner/repo` or a `repos/owner/…` api path
    for arg in argv:
        if arg.startswith("-"):
            continue
        owner = owner_of(arg)
        if owner:
            return owner
    return None


def owner_from_cwd() -> str | None:
    result = subprocess.run(
        ["git", "remote", "get-url", "origin"],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return None
    match = REMOTE.search(result.stdout.strip())
    return match.group(1) if match else None


def main() -> int:
    argv = sys.argv[1:]
    owner = owner_from_args(argv) or owner_from_cwd()

    environment = dict(os.environ)
    if owner:
        key = "GH_TOKEN_" + re.sub(r"[^A-Za-z0-9]", "_", owner).upper()
        token = os.environ.get(key)
        if token:
            environment["GH_TOKEN"] = token

    os.execve(real_gh(), ["gh"] + argv, environment)


if __name__ == "__main__":
    raise SystemExit(main())
