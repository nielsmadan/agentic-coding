#!/usr/bin/env python3
"""Git credential helper for the fleet: answers github.com with the token for the repo's owner.

Picks `GH_TOKEN_<OWNER>` like `bin/gh`, falling back to `GH_TOKEN`. Never stores anything.
"""

from __future__ import annotations

import os
import re
import sys


def parse(text: str) -> dict[str, str]:
    return dict(line.split("=", 1) for line in text.splitlines() if "=" in line)


def token_for(request: dict[str, str], env: dict[str, str]) -> str | None:
    if request.get("protocol") != "https" or request.get("host") != "github.com":
        return None
    owner = request.get("path", "").split("/", 1)[0]
    key = "GH_TOKEN_" + re.sub(r"[^A-Za-z0-9]", "_", owner).upper()
    return (env.get(key) if owner else None) or env.get("GH_TOKEN")


def answer(action: str, request_text: str, env: dict[str, str]) -> str:
    if action != "get":
        return ""
    token = token_for(parse(request_text), env)
    return f"username=x-access-token\npassword={token}\n" if token else ""


def main() -> int:
    action = sys.argv[1] if len(sys.argv) > 1 else ""
    sys.stdout.write(answer(action, sys.stdin.read(), dict(os.environ)))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
