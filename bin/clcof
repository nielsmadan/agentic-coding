#!/usr/bin/env python3
"""Print a fresh fork-session name for the current cwd's most recent session.

Picks the most recent transcript for the current cwd, reads its durable name,
strips any trailing 6-hex suffix, appends a fresh one, and prints:

    <base>-<hex>

Falls back to base name "main" if no prior session exists for this cwd.

This only emits the name — the actual `claude --continue --fork-session` launch
is done by the `clcof` zsh function (see .airc.d/claude.zsh), which routes
through the sops-wrapped `claude` shell function so the injected auth token
reaches the subprocess. Exec'ing `claude` here would bypass that wrapper and
trigger a login prompt.
"""
from __future__ import annotations

import json
import os
import re
import secrets
from pathlib import Path


SUFFIX_RE = re.compile(r"-[0-9a-f]{6}$")
SLUG_MAX_LEN = 200
NAME_KEYS = ("customTitle", "agentName", "aiTitle")


def rolling_hash(value: str) -> int:
    result = 0
    for char in value:
        result = (result << 5) - result + ord(char)
        result &= 0xFFFFFFFF
        if result >= 0x80000000:
            result -= 0x100000000
    return result


def base36(value: int) -> str:
    if value == 0:
        return "0"
    digits = "0123456789abcdefghijklmnopqrstuvwxyz"
    result = ""
    while value:
        value, remainder = divmod(value, 36)
        result = digits[remainder] + result
    return result


def project_slug(cwd: str) -> str:
    slug = re.sub(r"[^a-zA-Z0-9]", "-", cwd)
    if len(slug) <= SLUG_MAX_LEN:
        return slug
    return slug[:SLUG_MAX_LEN] + "-" + base36(abs(rolling_hash(cwd)))


def transcript_name(path: Path) -> str | None:
    latest: dict[str, str] = {}
    try:
        with path.open(encoding="utf-8") as transcript:
            for line in transcript:
                if 'Title"' not in line and 'Name"' not in line:
                    continue
                try:
                    entry = json.loads(line)
                except json.JSONDecodeError:
                    continue
                for key in NAME_KEYS:
                    value = entry.get(key)
                    if isinstance(value, str) and value:
                        latest[key] = value
    except OSError:
        return None
    return latest.get("customTitle") or latest.get("agentName") or latest.get("aiTitle")


def latest_transcript(cwd: str, home: Path) -> Path | None:
    directory = home / ".claude" / "projects" / project_slug(cwd)
    try:
        transcripts = (path for path in directory.glob("*.jsonl") if path.is_file())
        return max(transcripts, key=lambda path: path.stat().st_mtime, default=None)
    except OSError:
        return None


def registry_name(cwd: str, home: Path, session_id: str | None = None) -> str | None:
    best_name: str | None = None
    best_updated = -1
    for path in (home / ".claude" / "sessions").glob("*.json"):
        try:
            data = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        if data.get("cwd") != cwd:
            continue
        if session_id is not None and data.get("sessionId") != session_id:
            continue
        updated = data.get("updatedAt")
        if not isinstance(updated, (int, float)):
            continue
        if updated > best_updated:
            best_updated = updated
            best_name = data.get("name") or None
    return best_name


def latest_session_name(cwd: str, home: Path | None = None) -> str | None:
    home = home or Path.home()
    transcript = latest_transcript(cwd, home)
    if transcript is not None:
        return transcript_name(transcript) or registry_name(cwd, home, transcript.stem)
    return registry_name(cwd, home)


def main() -> int:
    base = "main"
    recent = latest_session_name(os.getcwd())
    if recent:
        base = SUFFIX_RE.sub("", recent)
    print(f"{base}-{secrets.token_hex(3)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
