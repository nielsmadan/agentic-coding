#!/usr/bin/env python3
"""Print a fresh fork-session name for the current cwd's most recent session.

Picks the most recent session for the current cwd from ~/.claude/sessions/*.json,
strips its trailing 6-hex suffix, appends a fresh one, and prints:

    <base>-<hex>

Falls back to base name "main" if no prior session exists for this cwd.

This only emits the name — the actual `claude --continue --fork-session` launch
is done by the `clcof` zsh function (see .airc.d/claude.zsh), which routes
through the sops-wrapped `claude` shell function so the injected auth token
reaches the subprocess. Exec'ing `claude` here would bypass that wrapper and
trigger a login prompt.
"""
from __future__ import annotations

import glob
import json
import os
import re
import secrets
from pathlib import Path


SUFFIX_RE = re.compile(r"-[0-9a-f]{6}$")


def latest_session_name(cwd: str) -> str | None:
    best_name: str | None = None
    best_updated = -1
    pattern = str(Path.home() / ".claude" / "sessions" / "*.json")
    for path in glob.iglob(pattern):
        try:
            with open(path) as f:
                data = json.load(f)
        except (OSError, json.JSONDecodeError):
            continue
        if data.get("cwd") != cwd:
            continue
        updated = data.get("updatedAt")
        if not isinstance(updated, (int, float)):
            continue
        if updated > best_updated:
            best_updated = updated
            best_name = data.get("name") or None
    return best_name


def main() -> int:
    base = "main"
    recent = latest_session_name(os.getcwd())
    if recent:
        base = SUFFIX_RE.sub("", recent)
    print(f"{base}-{secrets.token_hex(3)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
