#!/usr/bin/env python3
"""Run the dedicated, hand-logged-in Chromium that agents drive over CDP."""

from __future__ import annotations

import argparse
import base64
import json
import os
import socket
import struct
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

PROFILE = Path.home() / ".agent-chromium"
PORT = int(os.environ.get("AGENT_CHROMIUM_PORT", "9222"))
BINARY = "/Applications/Chromium.app/Contents/MacOS/Chromium"
EX_CONFIG = 78


def endpoint(port: int, path: str) -> str:
    return f"http://127.0.0.1:{port}{path}"


def get_json(url: str, timeout: float = 2.0):
    with urllib.request.urlopen(url, timeout=timeout) as resp:
        return json.load(resp)


def is_up(port: int) -> bool:
    try:
        get_json(endpoint(port, "/json/version"))
        return True
    except (urllib.error.URLError, OSError, ValueError):
        return False


def launch_argv(binary: str, profile: Path, port: int, url: str | None) -> list[str]:
    return [
        binary,
        f"--user-data-dir={profile}",
        f"--remote-debugging-port={port}",
        "--remote-debugging-address=127.0.0.1",
        "--no-first-run",
        "--no-default-browser-check",
        # agent-browser's --cdp attach creates a stray about:blank when only internal pages are open (vercel-labs/agent-browser#1986)
        url or "about:blank",
    ]


def pick_target(targets: list[dict], match: str | None) -> dict | None:
    pages = [t for t in targets if t.get("type") == "page"]
    if not match:
        return pages[0] if pages else None
    needle = match.lower()
    return next((t for t in pages
                 if t.get("id", "").lower() == needle
                 or needle in t.get("url", "").lower() or needle in t.get("title", "").lower()),
                None)


def browser_pids(binary: str, profile: Path) -> list[int]:
    out = subprocess.run(["pgrep", "-f", "--", f"^{binary} --user-data-dir={profile} "],
                         capture_output=True, text=True).stdout
    return [int(p) for p in out.split()]


def ws_frame(payload: bytes, mask: bytes, opcode: int = 0x1) -> bytes:
    n = len(payload)
    if n < 126:
        head = struct.pack("!BB", 0x80 | opcode, 0x80 | n)
    elif n < 1 << 16:
        head = struct.pack("!BBH", 0x80 | opcode, 0x80 | 126, n)
    else:
        head = struct.pack("!BBQ", 0x80 | opcode, 0x80 | 127, n)
    return head + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(payload))


def read_exact(rfile, n: int) -> bytes:
    data = rfile.read(n)
    if len(data) < n:
        raise ConnectionError("CDP connection closed mid-frame")
    return data


def read_frame(rfile) -> tuple[bool, int, bytes]:
    b1, b2 = read_exact(rfile, 2)
    n = b2 & 0x7F
    if n == 126:
        (n,) = struct.unpack("!H", read_exact(rfile, 2))
    elif n == 127:
        (n,) = struct.unpack("!Q", read_exact(rfile, 8))
    return bool(b1 & 0x80), b1 & 0x0F, read_exact(rfile, n)


# A bare WebSocket client keeps this script stdlib-only.
class Cdp:
    def __init__(self, ws_url: str, timeout: float):
        url = urllib.parse.urlsplit(ws_url)
        self.sock = socket.create_connection((url.hostname, url.port), timeout=timeout)
        key = base64.b64encode(os.urandom(16)).decode()
        self.sock.sendall((f"GET {url.path} HTTP/1.1\r\nHost: {url.netloc}\r\n"
                           "Upgrade: websocket\r\nConnection: Upgrade\r\n"
                           f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n").encode())
        self.rfile = self.sock.makefile("rb")
        status = self.rfile.readline()
        if b" 101 " not in status:
            raise ConnectionError(f"CDP handshake refused: {status.decode(errors='replace').strip()}")
        while self.rfile.readline() not in (b"\r\n", b""):
            pass
        self.last_id = 0

    def recv(self) -> dict:
        parts = []
        while True:
            fin, opcode, data = read_frame(self.rfile)
            if opcode == 0x8:
                raise ConnectionError("CDP closed the connection")
            if opcode == 0x9:
                self.sock.sendall(ws_frame(data, os.urandom(4), 0xA))
                continue
            if opcode == 0xA:
                continue
            parts.append(data)
            if fin:
                return json.loads(b"".join(parts))

    def call(self, method: str, params: dict | None = None, session: str | None = None) -> dict:
        self.last_id += 1
        msg = {"id": self.last_id, "method": method, "params": params or {},
               **({"sessionId": session} if session else {})}
        self.sock.sendall(ws_frame(json.dumps(msg).encode(), os.urandom(4)))
        while True:
            reply = self.recv()
            if reply.get("id") == self.last_id:
                if "error" in reply:
                    raise RuntimeError(f"{method}: {reply['error'].get('message')}")
                return reply.get("result", {})

    def close(self) -> None:
        self.sock.close()


READINESS = "[document.readyState, location.href, document.title]"
CHALLENGE_TITLES = ("just a moment", "checking your browser", "attention required",
                    "verify you are human", "prove your humanity")


def evaluate(cdp: Cdp, session: str, expression: str) -> dict:
    return cdp.call("Runtime.evaluate", {"expression": expression, "awaitPromise": True,
                                         "returnByValue": True}, session)


def page_state(ready: str, href: str, title: str) -> str:
    if ready != "complete" or href == "about:blank":
        return "loading"
    if title.strip().lower().startswith(CHALLENGE_TITLES):
        return "challenge"
    return "ready"


def poll_page(cdp: Cdp, session: str) -> tuple[str, str]:
    try:
        ready, href, title = evaluate(cdp, session, READINESS)["result"]["value"]
    except RuntimeError as err:
        # Mid-navigation the page briefly has no execution context to evaluate in.
        if "execution context" in str(err):
            return "loading", ""
        raise
    return page_state(ready, href, title), title


def render(value) -> str:
    return value if isinstance(value, str) else json.dumps(value, ensure_ascii=False)


def cmd_read(opts) -> int:
    if not is_up(opts.port):
        print(f"agent-chromium: not running on port {opts.port}", file=sys.stderr)
        return 1
    cdp = Cdp(get_json(endpoint(opts.port, "/json/version"))["webSocketDebuggerUrl"],
              timeout=opts.timeout)
    # background: true is what keeps macOS from raising the window; agent-browser
    # activates the tab on open (vercel-labs/agent-browser#1247).
    target = cdp.call("Target.createTarget", {"url": opts.url, "background": True})["targetId"]
    try:
        session = cdp.call("Target.attachToTarget",
                           {"targetId": target, "flatten": True})["sessionId"]
        deadline = time.monotonic() + opts.timeout
        state, title = poll_page(cdp, session)
        while state != "ready":
            if time.monotonic() > deadline:
                print(f"agent-chromium: still on a challenge page ({title!r}) after "
                      f"{opts.timeout:g}s; it needs a human: re-run with --keep, then "
                      f"`agent-chromium show <site>`" if state == "challenge" else
                      f"agent-chromium: page did not finish loading in {opts.timeout:g}s",
                      file=sys.stderr)
                return 1
            time.sleep(0.5)
            state, title = poll_page(cdp, session)
        result = evaluate(cdp, session, opts.expression)
        if "exceptionDetails" in result:
            details = result["exceptionDetails"]
            print(f"agent-chromium: {details.get('exception', {}).get('description') or details.get('text')}",
                  file=sys.stderr)
            return 1
        print(render(result["result"].get("value")))
        return 0
    finally:
        if opts.keep:
            print(f"agent-chromium: kept tab {target}; `agent-chromium show {target}` raises it, "
                  f"`agent-chromium close {target}` closes it", file=sys.stderr)
        else:
            cdp.call("Target.closeTarget", {"targetId": target})
        cdp.close()


def cmd_start(opts) -> int:
    if is_up(opts.port):
        print(endpoint(opts.port, ""))
        return 0
    if os.environ.get("AGENT_SANDBOX"):
        print("agent-chromium: not running, and it cannot start inside the sandbox; "
              "ask the user to run `agent-chromium start` in their own terminal",
              file=sys.stderr)
        return EX_CONFIG
    PROFILE.mkdir(exist_ok=True)
    subprocess.Popen(launch_argv(BINARY, PROFILE, opts.port, opts.url),
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)
    deadline = time.monotonic() + 20
    while time.monotonic() < deadline:
        if is_up(opts.port):
            print(endpoint(opts.port, ""))
            return 0
        time.sleep(0.5)
    print(f"agent-chromium: started but port {opts.port} never answered", file=sys.stderr)
    return 1


def cmd_status(opts) -> int:
    if not is_up(opts.port):
        print(f"agent-chromium: not running on port {opts.port}", file=sys.stderr)
        return 1
    pages = [t for t in get_json(endpoint(opts.port, "/json/list")) if t.get("type") == "page"]
    print(endpoint(opts.port, ""))
    for t in pages:
        print(f"  {t.get('title', '')[:70]}  {t.get('url', '')}")
    return 0


def cmd_show(opts) -> int:
    if not is_up(opts.port):
        print(f"agent-chromium: not running on port {opts.port}", file=sys.stderr)
        return 1
    target = pick_target(get_json(endpoint(opts.port, "/json/list")), opts.match)
    if target is None:
        print(f"agent-chromium: no tab matches {opts.match!r}", file=sys.stderr)
        return 1
    urllib.request.urlopen(
        endpoint(opts.port, f"/json/activate/{urllib.parse.quote(target['id'])}"), timeout=2
    ).close()
    # System Events is unreachable from the sandbox; there the tab switch is all we get.
    pids = browser_pids(BINARY, PROFILE)
    if pids and not os.environ.get("AGENT_SANDBOX"):
        subprocess.run(["osascript", "-e",
                        'tell application "System Events" to set frontmost of '
                        f"(first process whose unix id is {pids[0]}) to true"],
                       capture_output=True)
    print(f"{target.get('title', '')}  {target.get('url', '')}")
    return 0


def cmd_close(opts) -> int:
    if not is_up(opts.port):
        print(f"agent-chromium: not running on port {opts.port}", file=sys.stderr)
        return 1
    target = pick_target(get_json(endpoint(opts.port, "/json/list")), opts.match)
    if target is None:
        print(f"agent-chromium: no tab matches {opts.match!r}", file=sys.stderr)
        return 1
    urllib.request.urlopen(
        endpoint(opts.port, f"/json/close/{urllib.parse.quote(target['id'])}"), timeout=2
    ).close()
    print(f"closed {target.get('title', '')}  {target.get('url', '')}")
    return 0


def cmd_stop(opts) -> int:
    pids = browser_pids(BINARY, PROFILE)
    if not pids:
        print("agent-chromium: not running", file=sys.stderr)
        return 0
    subprocess.run(["kill", *map(str, pids)], check=False)
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="agent-chromium",
        description=f"Dedicated Chromium (profile {PROFILE}) that agents attach to with "
                    f"`agent-browser --cdp {PORT}`. The user logs into sites in its window.",
    )
    p.add_argument("--port", type=int, default=PORT,
                   help=f"CDP port (default: $AGENT_CHROMIUM_PORT, else {PORT})")
    sub = p.add_subparsers(dest="cmd", required=True)
    start = sub.add_parser("start", help="launch it if not running; print the CDP endpoint")
    start.add_argument("url", nargs="?", help="page to open on launch")
    sub.add_parser("status", help="exit 0 and list open tabs if running")
    show = sub.add_parser("show", help="bring a tab (matched by URL or title) to the front")
    show.add_argument("match", nargs="?", help="substring of the tab's URL or title")
    read = sub.add_parser("read", help="load a page in a background tab, print a JS expression's "
                                       "value, close the tab; never raises the window")
    read.add_argument("url")
    read.add_argument("expression", nargs="?", default="document.body.innerText",
                      help="evaluated in the page; promises are awaited, strings print raw, "
                           "anything else as JSON (default: document.body.innerText)")
    read.add_argument("--timeout", type=float, default=30, help="seconds to wait for the load")
    read.add_argument("--keep", action="store_true",
                      help="leave the tab open, e.g. to hand a challenge page to the user")
    close = sub.add_parser("close", help="close one tab (matched by id, URL or title) "
                                         "without raising the window")
    close.add_argument("match", help="tab id, or substring of the tab's URL or title")
    sub.add_parser("stop", help="quit it (logins persist in the profile)")
    return p


def main() -> int:
    opts = build_parser().parse_args()
    return {"start": cmd_start, "status": cmd_status, "show": cmd_show,
            "read": cmd_read, "close": cmd_close, "stop": cmd_stop}[opts.cmd](opts)


if __name__ == "__main__":
    sys.exit(main())
