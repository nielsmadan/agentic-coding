<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nielsmadan.agent-device-daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin"; exec "$HOME/.local/bin/agent-device-daemon" ensure &gt;&gt;"$HOME/Library/Logs/agent-device-daemon.log" 2&gt;&amp;1</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Brings the daemon back after an agent-device upgrade replaces it with a short-lived one. -->
    <key>StartInterval</key>
    <integer>300</integer>

    <!-- The daemon outlives the job; launchd must not reap it when `ensure` exits. -->
    <key>AbandonProcessGroup</key>
    <true/>
</dict>
</plist>
