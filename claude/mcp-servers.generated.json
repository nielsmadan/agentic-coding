{
  "context7": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "@upstash/context7-mcp"
    ],
    "env": {}
  },
  "jina": {
    "type": "http",
    "url": "https://mcp.jina.ai/v1",
    "headers": {
      "Authorization": "Bearer ${JINA_API_KEY}"
    }
  },
  "railway": {
    "type": "stdio",
    "command": "railway",
    "args": [
      "mcp"
    ],
    "env": {}
  }
}
